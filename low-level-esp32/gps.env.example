# Copy the four existing RabbitMQ settings locally; no real credentials in Git.
spring.rabbitmq.host=127.0.0.1
spring.rabbitmq.port=5672
spring.rabbitmq.username=CHANGE_ME
spring.rabbitmq.password=CHANGE_ME
BLUETOOTH_ADAPTER=hci0
BLE_SCAN_SECONDS=10
BLE_CLIENT_CONNECT_TIMEOUT_SECONDS=30
SCANNER_OPERATION_TIMEOUT_SECONDS=20
BLE_CLEANUP_TIMEOUT_SECONDS=10
BLE_RECONNECT_DELAY_SECONDS=60
BLE_RECONNECT_MAX_SECONDS=900
BLE_NOTIFICATION_IDLE_SECONDS=300
BLE_FAILURE_LIMIT=5
BLE_PROCESS_RESTART_DELAY_SECONDS=60
HEALTH_INTERVAL_SECONDS=30
STARTUP_DELAY_SECONDS=15
# Empty disables the rotating file; Docker stdout logs remain available.
GPS_LOG_FILE=/app/fail/gps-ESP32.log
